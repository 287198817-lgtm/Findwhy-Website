---
import { getEntry } from 'astro:content';
import { readdir } from 'node:fs/promises';
import path from 'node:path';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

interface Props {
	project: string;
}

const { project } = Astro.props;
const entry = await getEntry('projects', project);
if (!entry) throw new Error(`Project content not found: ${project}`);

const projectInfo = entry.data;
const supportedImage = /\.(?:jpe?g|png|webp)$/i;
const numericSort = (a: string, b: string) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
const projectDirectory = path.join(process.cwd(), 'public', 'media', 'projects', project);
const directoryImages = projectInfo.images.length === 0
	? (await readdir(projectDirectory).catch(() => [])).filter((file) => supportedImage.test(file)).sort(numericSort)
	: [];
const projectImages = projectInfo.images.length > 0 ? projectInfo.images : directoryImages;
const mediaPath = (file: string) => file.startsWith('/') ? file : `/media/projects/${project}/${encodeURIComponent(file)}`;
const images = projectImages
	.filter(Boolean)
	.map((file, index) => ({ src: mediaPath(file), number: index + 1 }));
const columns = Array.from({ length: 4 }, (_, column) => images.filter((_, index) => index % 4 === column));
---

<PortfolioLayout title="Findwhy — Project" description="A project by Findwhy." active="projects">
	<article class="project-page">
		<header class="project-intro">
			<h1>{projectInfo.title}</h1>
			<p class="description">{projectInfo.description}</p>
			{projectInfo.services.length > 0 && (
				<div class="services">
					<p>Services:</p>
					{projectInfo.services.map((service) => <p>{service}</p>)}
				</div>
			)}
		</header>

		<section class="project-gallery" aria-label="Project images">
			{columns.map((column) => (
				<div class="gallery-column">
					{column.map((image) => <img src={image.src} alt={`Project image ${image.number}`} loading={image.number <= 4 ? 'eager' : 'lazy'} decoding="async" />)}
				</div>
			))}
		</section>
	</article>
</PortfolioLayout>

<style>
	.project-page { padding-top: clamp(60px, 6vw, 95px); }
	.project-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; width: 100%; min-height: 260px; padding: 0 50px 48px; }
	h1 { margin: 0; font-size: 13px; line-height: 1; font-weight: 400; letter-spacing: .04em; }
	.project-intro p { margin: 0; font-size: 13px; line-height: 1.8; }
	.description { max-width: 430px; }
	.services { display: flex; flex-direction: column; }
	.services p:first-child { margin-bottom: 12px; }
	.project-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 50px; width: 100%; min-height: 45vh; padding: 20px 50px 50px; }
	.gallery-column { display: flex; flex-direction: column; gap: 50px; min-width: 0; }
	.gallery-column img { display: block; width: 100%; height: auto; object-fit: contain; }
	@media (max-width: 809px) {
		.project-page { padding-top: 48px; }
		.project-intro { gap: 28px; min-height: 240px; padding: 0 20px 40px; }
		.project-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 16px 20px 60px; }
		.gallery-column { gap: 24px; }
	}
	@media (max-width: 520px) {
		.project-gallery { grid-template-columns: 1fr; }
	}
</style>
