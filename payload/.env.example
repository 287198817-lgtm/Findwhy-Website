NODE_ENV=development
PORT=3000
HOSTNAME=127.0.0.1
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/findwhy_payload
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_SERVER_URL=http://localhost:3000

# Vercel Blob (Videos and WebVideos)
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Alibaba Cloud OSS (server-only; never expose these through NEXT_PUBLIC_*)
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
ALIYUN_OSS_BUCKET=findwhy-assets
ALIYUN_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_PUBLIC_BASE_URL=https://img.findwhy.art
IMAGES_STORAGE_ENV=local
ENABLE_IMAGES_STORAGE_ROUTER=false
