---
import ImageLightbox from './ImageLightbox.astro';

interface Item { src: string; number: number }
interface Props { items: Item[]; type: 'image' | 'video' }
const { items, type } = Astro.props;
const columns = Array.from({ length: 4 }, (_, column) => items.filter((_, index) => index % 4 === column));
---

<section class="gallery" data-gallery={type} aria-label={type === 'image' ? 'Illustration works' : 'Animation works'}>
	{columns.map((column) => (
		<div class="gallery-column">
			{column.map((item) => type === 'image' ? (
				<button class="media-item image-item" type="button" data-lightbox-index={item.number - 1} aria-label={`Open illustration ${item.number}`}>
					<img src={item.src} alt={`Findwhy illustration ${item.number}`} loading={item.number <= 4 ? 'eager' : 'lazy'} decoding="async" />
				</button>
			) : (
				<div class="media-item video-item">
					<video muted loop playsinline preload={item.number <= 4 ? 'auto' : 'metadata'} aria-label={`Findwhy animation ${item.number}`}>
						<source src={item.src} type="video/mp4" />
					</video>
				</div>
			))}
		</div>
	))}
</section>

{type === 'image' && <ImageLightbox items={items} triggerSelector=".gallery .image-item" ariaLabel="Illustration viewer" />}

<script define:vars={{ type }}>
	if (type === 'video') {
		const canHover = matchMedia('(hover: hover)').matches;
		document.querySelectorAll('video').forEach((video) => {
			if (canHover) {
				video.addEventListener('pointerenter', () => video.play().catch(() => {}));
				video.addEventListener('pointerleave', () => { video.pause(); video.currentTime = 0; });
			} else {
				new IntersectionObserver(([entry]) => entry.isIntersecting ? video.play().catch(() => {}) : video.pause(), { threshold: .5 }).observe(video);
			}
		});
	}
</script>

<style>
	.gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 50px; width: 100%; padding: 50px; }
	.gallery-column { display: flex; flex-direction: column; gap: 50px; min-width: 0; }
	.media-item { display: block; width: 100%; margin: 0; padding: 0; border: 0; background: transparent; overflow: hidden; }
	.image-item { cursor: zoom-in; }
	.media-item img, .media-item video { display: block; width: 100%; height: auto; object-fit: contain; transition: transform .45s ease, opacity .3s ease; }
	.image-item:hover img, .image-item:focus-visible img { transform: scale(1.015); opacity: .96; }
	.image-item:focus-visible { outline: 1px solid #000; outline-offset: 5px; }
	.video-item { cursor: pointer; }
	@media (max-width: 809px) {
		.gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 42px 20px 60px; }
		.gallery-column { gap: 24px; }
	}
	@media (max-width: 520px) { .gallery { grid-template-columns: 1fr; } }
</style>
