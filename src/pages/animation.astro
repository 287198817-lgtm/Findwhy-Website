---
import Gallery from '../components/Gallery.astro';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { getAnimations } from '../lib/payload/animations';

const payloadAnimations = await getAnimations();
const animations = payloadAnimations.map((entry, index) => ({
	src: entry.video,
	poster: entry.poster,
	number: index + 1,
}));
---

<PortfolioLayout title="Findwhy — Animation" description="Findwhy animation portfolio." active="animation">
	<Gallery items={animations} type="video" />
</PortfolioLayout>
