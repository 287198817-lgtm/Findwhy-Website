---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ImageLightbox from './ImageLightbox.astro';
import type { ProjectItem } from '../lib/payload/projects';

interface Props {
	project: ProjectItem;
}

const { project } = Astro.props;
const titleEn = project.titleEn;
const titleZh = project.titleZh;
const descriptionEn = project.descriptionEn;
const descriptionZh = project.descriptionZh;
const projectMeta = [project.type?.trim(), project.year]
	.filter((value) => value !== undefined && value !== null && value !== '')
	.join(' · ');
const videoItems = project.videos.map((video, index) => ({
	type: 'video' as const,
	url: video.src,
	cover: video.cover,
	order: index,
	number: index + 1,
}));
const imageItems = project.images.map((url, index) => ({
	type: 'image' as const,
	url,
	order: videoItems.length + index,
	number: index + 1,
	lightboxIndex: index,
}));
const mediaList = [...videoItems, ...imageItems].sort((a, b) => a.order - b.order);
const lightboxImages = imageItems.map((image) => ({
	kind: 'image' as const,
	src: image.url,
	number: image.number,
}));
const columns = Array.from({ length: 4 }, (_, column) => mediaList.filter((_, index) => index % 4 === column));
---

<PortfolioLayout title="Findwhy — Project" description="A project by Findwhy." active="projects">
	<article class="project-page">
		<header class="project-intro">
			<h1 class="translatable" data-en={titleEn} data-zh={titleZh}>{titleEn}</h1>
			<p class="description translatable" data-en={descriptionEn} data-zh={descriptionZh}>{descriptionEn}</p>
			{projectMeta && <p class="project-meta">{projectMeta}</p>}
			{project.services.length > 0 && (
				<div class="services">
					<p>Services:</p>
					{project.services.map((service) => <p>{service}</p>)}
				</div>
			)}
		</header>

		<section class="project-gallery" aria-label="Project images">
			{columns.map((column) => (
				<div class="gallery-column">
					{column.map((item) => item.type === 'image' ? (
						<button class="media-button image-button" type="button" data-lightbox-index={item.lightboxIndex} aria-label={`View project image ${item.number}`}>
							<img src={item.url} alt={`Project image ${item.number}`} loading={item.number <= 4 ? 'eager' : 'lazy'} decoding="async" />
						</button>
					) : (
						<button class="media-button video-button" type="button" data-video-src={item.url} aria-label={`Play project video ${item.number}`}>
							{item.cover ? <img src={item.cover} alt="" loading="eager" decoding="async" /> : <span class="video-placeholder" aria-hidden="true"></span>}
							<span class="play-icon" aria-hidden="true"></span>
						</button>
					))}
				</div>
			))}
		</section>

		<ImageLightbox items={lightboxImages} triggerSelector=".project-gallery .image-button" ariaLabel="Project image viewer" altPrefix="Project image" />

		<dialog class="media-dialog video-dialog" aria-label="Project video player">
			<button class="dialog-close" type="button" aria-label="Close video player">CLOSE</button>
			<video controls muted loop playsinline></video>
		</dialog>
	</article>
</PortfolioLayout>

<script>
	const videoDialog = document.querySelector<HTMLDialogElement>('.video-dialog');
	const dialogVideo = videoDialog?.querySelector<HTMLVideoElement>('video');

	const closeVideo = () => {
		if (dialogVideo) {
			dialogVideo.pause();
			dialogVideo.removeAttribute('src');
			dialogVideo.load();
		}
		videoDialog?.close();
	};

	document.querySelectorAll<HTMLButtonElement>('.video-button').forEach((button) => {
		button.addEventListener('click', async () => {
			if (!videoDialog || !dialogVideo || !button.dataset.videoSrc) return;
			dialogVideo.src = button.dataset.videoSrc;
			videoDialog.showModal();
			await dialogVideo.play().catch(() => undefined);
		});
	});

	videoDialog?.querySelector<HTMLButtonElement>('.dialog-close')?.addEventListener('click', closeVideo);
	videoDialog?.addEventListener('click', (event) => { if (event.target === videoDialog) closeVideo(); });
	videoDialog?.addEventListener('cancel', () => {
		if (dialogVideo) {
			dialogVideo.pause();
			dialogVideo.removeAttribute('src');
			dialogVideo.load();
		}
	});
</script>

<style>
	.project-page { padding-top: clamp(60px, 6vw, 95px); }
	.project-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; width: 100%; min-height: 260px; padding: 0 50px 48px; }
	h1 { margin: 0; font-size: 14px; line-height: 1; font-weight: 400; letter-spacing: .04em; }
	.project-intro p { margin: 0; font-size: 13px; line-height: 1.8; }
	.project-intro .project-meta { color: #777; font-size: 12px; line-height: 1.4; letter-spacing: .03em; }
	.project-intro .description { max-width: 430px; font-size: 11px; }
	.services { display: flex; flex-direction: column; }
	.services p:first-child { margin-bottom: 12px; }
	.project-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 50px; width: 100%; min-height: 45vh; padding: 20px 50px 50px; }
	.gallery-column { display: flex; flex-direction: column; gap: 50px; min-width: 0; }
	.media-button { display: block; position: relative; width: 100%; border: 0; margin: 0; padding: 0; overflow: hidden; background: transparent; cursor: pointer; }
	.media-button img { display: block; width: 100%; height: auto; object-fit: contain; }
	.video-placeholder { display: block; width: 100%; aspect-ratio: 16 / 9; background: #111; }
	.play-icon { display: grid; place-items: center; position: absolute; top: 50%; left: 50%; width: 52px; height: 52px; border: 1px solid rgba(255, 255, 255, .9); border-radius: 50%; background: rgba(0, 0, 0, .28); transform: translate(-50%, -50%); }
	.play-icon::after { content: ''; width: 0; height: 0; margin-left: 3px; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 10px solid #fff; }
	.media-dialog { position: fixed; inset: 0; width: 100vw; max-width: none; height: 100vh; max-height: none; border: 0; margin: 0; padding: 35px; background: rgba(0, 0, 0, .9); }
	.media-dialog[open] { display: grid; place-items: center; }
	.media-dialog::backdrop { background: rgba(0, 0, 0, .72); }
	.video-dialog { background: #000; }
	.video-dialog video { display: block; max-width: 100%; max-height: calc(100vh - 70px); width: auto; height: auto; }
	.dialog-close { position: fixed; top: 24px; right: 28px; z-index: 2; border: 0; padding: 8px; color: #fff; background: transparent; font-size: 11px; letter-spacing: .05em; cursor: pointer; }
	@media (max-width: 809px) {
		.project-page { padding-top: 48px; }
		.project-intro { gap: 28px; min-height: 240px; padding: 0 20px 40px; }
		.project-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 16px 20px 60px; }
		.gallery-column { gap: 24px; }
		.media-dialog { padding: 20px; }
		.video-dialog video { max-height: calc(100vh - 40px); }
		.dialog-close { top: 12px; right: 12px; }
	}
	@media (max-width: 520px) {
		.project-gallery { grid-template-columns: 1fr; }
	}
</style>
