---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { getAbout } from '../lib/payload/about';

const about = await getAbout();
const cleanIntro = (paragraph: string) => paragraph.replace(/^2[ \t]*/, '');
const serviceRows = Array.from(
	{ length: Math.max(about.servicesZh.length, about.servicesEn.length) },
	(_, index) => ({
		zh: about.servicesZh[index] ?? '',
		en: about.servicesEn[index] ?? '',
	}),
);
---

<PortfolioLayout title="Findwhy — About" description="About Findwhy." active="about">
	<section class="about-intro">
		<div class="about-copy">
			<div class="copy-zh">
				{about.introZh.map((paragraph) => <p>{cleanIntro(paragraph)}</p>)}
			</div>
			<div class="copy-en">
				{about.introEn.map((paragraph) => <p>{cleanIntro(paragraph)}</p>)}
			</div>
		</div>
		{about.portrait && <img class="portrait" src={about.portrait} alt="Findwhy surrounded by illustration work" width="1440" height="1921" />}
	</section>

	<section class="about-info">
		<div>
			<h2 class="translatable" data-en={about.servicesTitleEn} data-zh={about.servicesTitleZh}>{about.servicesTitleEn}</h2>
			{serviceRows.map((service) => <p class="translatable" data-en={service.en} data-zh={service.zh}>{service.en}</p>)}
		</div>
		<div>
			<h2 class="translatable" data-en={about.clientsTitleEn} data-zh={about.clientsTitleZh}>{about.clientsTitleEn}</h2>
			{about.clients.map((client) => <p>{client}</p>)}
		</div>
		<div>
			<h2 class="translatable" data-en={about.contactTitleEn} data-zh={about.contactTitleZh}>{about.contactTitleEn}</h2>
			{about.email && <p class="contact"><a href={`mailto:${about.email}`}>{about.email}</a></p>}
			{about.instagramUrl && <p class="contact"><a href={about.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a></p>}
			{about.xiaohongshuUrl && <p class="contact"><a class="translatable" href={about.xiaohongshuUrl} target="_blank" rel="noopener noreferrer" data-en="Xiaohongshu ↗" data-zh="小红书 ↗">Xiaohongshu ↗</a></p>}
		</div>
	</section>
</PortfolioLayout>

<style>
	.about-intro { display: flex; align-items: center; justify-content: space-between; width: min(63%, 1210px); margin: 0 auto; padding: 50px 50px 50px; }
	.about-copy { display: flex; flex-direction: column; gap: 24px; width: 673px; padding: 0; }
	.about-copy p { margin: 0; font-size: 16px; line-height: 2; white-space: pre-wrap; }
	.portrait { display: block; flex: 0 0 400px; width: 400px; height: auto; aspect-ratio: .7496; object-fit: cover; }
	.about-info { display: flex; align-items: flex-start; gap: 80px; width: min(65%, 1248px); min-height: 538px; margin: 0 auto; padding: 80px; }
	.about-info > div { flex: 1 1 0; min-width: 0; }
	.about-info h2 { margin: 0 0 16px; font-size: 24px; line-height: 1.2; font-weight: 700; }
	.about-info p { margin: 0; font-size: 16px; line-height: 2; }
	.about-info .contact { line-height: 3; }
	.about-info a { color: inherit; text-decoration: none; }
	@media (max-width: 1500px) {
		.about-intro { width: 82%; }
		.about-copy { width: calc(100% - 440px); }
		.about-copy p { white-space: pre-wrap; }
		.about-info { width: 82%; }
	}
	@media (max-width: 1000px) {
		.about-intro { width: 100%; gap: 50px; padding: 150px 50px 50px; }
		.about-copy { width: calc(100% - 350px); padding: 0; }
		.portrait { flex-basis: 300px; width: 300px; }
		.about-info { width: 100%; gap: 45px; padding: 70px 50px; }
	}
	@media (max-width: 700px) {
		.about-intro { flex-direction: column; align-items: flex-start; gap: 0; padding: 110px 20px 40px; }
		.about-copy { width: 100%; padding: 0 0 50px; }
		.about-copy p, .about-info p { font-size: 14px; }
		.portrait { width: 100%; max-width: 400px; align-self: flex-end; }
		.about-info { flex-direction: column; gap: 60px; min-height: 0; padding: 60px 20px 100px; }
		.about-info > div { width: 100%; }
		.about-info h2 { font-size: 21px; }
	}
</style>
