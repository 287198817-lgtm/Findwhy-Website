<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="prefetch" href="/illustration" />
		<title>Findwhy</title>
	</head>
	<body>
		<main class="intro" aria-label="Findwhy">
			<img src="/media/home/intro.png" alt="" width="800" height="800" />
		</main>

		<script>
			const intro = document.querySelector('.intro');
			const image = intro?.querySelector('img');
			let started = false;

			const enterSite = () => window.location.replace('/illustration');
			const beginIntro = () => {
				if (started) return;
				started = true;
				window.setTimeout(() => intro?.classList.add('is-leaving'), 800);
				window.setTimeout(enterSite, 1250);
			};

			try {
				if (sessionStorage.getItem('findwhy-intro-seen')) {
					enterSite();
				} else {
					sessionStorage.setItem('findwhy-intro-seen', 'true');
					image?.addEventListener('load', beginIntro, { once: true });
					image?.addEventListener('error', enterSite, { once: true });
					if (image?.complete) image.naturalWidth ? beginIntro() : enterSite();
					window.setTimeout(() => { if (!started) enterSite(); }, 2000);
				}
			} catch {
				beginIntro();
			}
		</script>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { width: 100%; height: 100%; margin: 0; background: #fff; }
	.intro { position: fixed; inset: 0; display: grid; place-items: center; background: #fff; opacity: 1; transition: opacity 450ms ease; }
	.intro.is-leaving { opacity: 0; pointer-events: none; }
	.intro img { display: block; width: 220px; max-width: 40vw; height: auto; object-fit: contain; }
	@media (max-width: 600px) { .intro img { width: 38vw; max-width: 180px; } }
	@media (prefers-reduced-motion: reduce) { .intro { transition-duration: 1ms; } }
</style>
