---
interface Item { src: string; number: number }
interface Props {
	items: Item[];
	triggerSelector: string;
	ariaLabel?: string;
	altPrefix?: string;
}

const {
	items,
	triggerSelector,
	ariaLabel = 'Image viewer',
	altPrefix = 'Findwhy illustration',
} = Astro.props;
---

<dialog class="lightbox" aria-label={ariaLabel}>
	<button class="close" type="button" aria-label="Close">CLOSE</button>
	<button class="previous" type="button" aria-label="Previous image">←</button>
	<img src="" alt="" />
	<button class="next" type="button" aria-label="Next image">→</button>
</dialog>

<script define:vars={{ items, triggerSelector, altPrefix }}>
	const dialog = document.querySelector('.lightbox');
	const image = dialog?.querySelector('img');
	let current = 0;

	const show = (index) => {
		if (!dialog || !image || items.length === 0) return;
		current = (index + items.length) % items.length;
		image.src = items[current].src;
		image.alt = `${altPrefix} ${current + 1}`;
		if (!dialog.open) dialog.showModal();
	};

	document.querySelectorAll(triggerSelector).forEach((button) => {
		button.addEventListener('click', () => show(Number(button.dataset.lightboxIndex)));
	});
	dialog?.querySelector('.close')?.addEventListener('click', () => dialog.close());
	dialog?.querySelector('.previous')?.addEventListener('click', () => show(current - 1));
	dialog?.querySelector('.next')?.addEventListener('click', () => show(current + 1));
	dialog?.addEventListener('click', (event) => event.target === dialog && dialog.close());
	document.addEventListener('keydown', (event) => {
		if (!dialog?.open) return;
		if (event.key === 'ArrowLeft') show(current - 1);
		if (event.key === 'ArrowRight') show(current + 1);
	});
</script>

<style>
	.lightbox { width: 100vw; max-width: none; height: 100vh; max-height: none; margin: 0; padding: 35px; border: 0; background: rgba(255,255,255,.98); }
	.lightbox[open] { display: grid; grid-template-columns: 70px 1fr 70px; align-items: center; justify-items: center; }
	.lightbox::backdrop { background: rgba(255,255,255,.96); }
	.lightbox img { grid-column: 2; max-width: 100%; max-height: calc(100vh - 70px); width: auto; height: auto; object-fit: contain; }
	.lightbox button { border: 0; background: transparent; cursor: pointer; }
	.close { position: fixed; top: 26px; right: 30px; z-index: 2; font-size: 11px; letter-spacing: .04em; }
	.previous { grid-column: 1; grid-row: 1; }
	.next { grid-column: 3; grid-row: 1; }
	@media (max-width: 809px) {
		.lightbox { padding: 20px; }
		.lightbox[open] { grid-template-columns: 40px 1fr 40px; }
	}
</style>
