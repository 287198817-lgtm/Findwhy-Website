---
import { getCollection, getEntry } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { getSeriesImages } from '../../lib/seriesMedia';
import { resolveMediaUrl } from '../../lib/mediaUrl';

export async function getStaticPaths() {
	const series = await getCollection('series');
	return series.filter((entry) => !entry.data.draft).map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Series slug is required.');

const entry = await getEntry('series', slug);
if (!entry) throw new Error(`Series content not found: ${slug}`);
if (entry.data.draft) throw new Error(`Series is not published: ${slug}`);

const titleEn = entry.data.title_en;
const titleZh = entry.data.title_zh;
const descriptionEn = entry.data.description_en;
const descriptionZh = entry.data.description_zh;
const coverSrc = entry.data.cover_image;
const galleryImages = entry.data.gallery_images.filter(Boolean);
const seriesImages = galleryImages.length > 0
	? galleryImages.map((image, index) => ({
		kind: 'image' as const,
		src: resolveMediaUrl(image, { basePath: `/media/series/${slug}` }),
		number: index + 1,
	}))
	: getSeriesImages(slug, entry.data.cover_image);
const images = [
	{ kind: 'image' as const, src: coverSrc, number: 1 },
	...seriesImages.map((image, index) => ({ ...image, number: index + 2 })),
];
---

<PortfolioLayout title={`Findwhy — ${titleEn}`} description={descriptionEn} active="illustration">
	<article class="series-page">
		<header class="series-intro">
			<h1 class="translatable" data-en={titleEn} data-zh={titleZh}>{titleEn}</h1>
			{(descriptionEn || descriptionZh) && <p class="translatable" data-en={descriptionEn} data-zh={descriptionZh}>{descriptionEn}</p>}
		</header>
		<Gallery items={images} type="image" />
	</article>
</PortfolioLayout>

<style>
	.series-page { padding-top: clamp(60px, 6vw, 95px); }
	.series-intro { display: flex; flex-direction: column; gap: 32px; min-height: 260px; padding: 0 50px 48px; }
	h1, p { margin: 0; font-size: 13px; font-weight: 400; line-height: 1.8; }
	h1 { line-height: 1; letter-spacing: .04em; }
	p { max-width: 430px; }
	@media (max-width: 809px) {
		.series-page { padding-top: 48px; }
		.series-intro { gap: 28px; min-height: 240px; padding: 0 20px 40px; }
	}
</style>
