---
import Gallery from '../components/Gallery.astro';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { getIllustrations } from '../lib/payload/illustrations';

const payloadIllustrations = await getIllustrations();
const illustrations = payloadIllustrations.map((entry, index) => ({
		kind: 'image' as const,
		src: entry.image,
		number: index + 1,
}));
---

<PortfolioLayout title="Findwhy" description="Findwhy illustration portfolio." active="illustration">
	<Gallery items={illustrations} type="image" />
</PortfolioLayout>
