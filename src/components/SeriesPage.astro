---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ImageLightbox from './ImageLightbox.astro';
import type { SeriesItem } from '../lib/payload/series';

interface Props { series: SeriesItem }
const { series } = Astro.props;
const videoItems = series.videos.map((video, index) => ({
	type: 'video' as const,
	url: video.src,
	cover: video.posterPreviewUrl ?? video.poster,
	order: index,
	number: index + 1,
}));
const imageItems = series.imageMedia.map((image, index) => ({
	type: 'image' as const,
	url: image.previewUrl,
	fullUrl: image.fullUrl,
	order: videoItems.length + index,
	number: index + 1,
	lightboxIndex: index,
}));
const mediaList = [...videoItems, ...imageItems].sort((a, b) => a.order - b.order);
const columns = Array.from({ length: 4 }, (_, column) => mediaList.filter((_, index) => index % 4 === column));
const lightboxImages = imageItems.map((image) => ({
	kind: 'image' as const,
	previewSrc: image.url,
	fullSrc: image.fullUrl,
	number: image.number,
}));
---

<PortfolioLayout title={`Findwhy — ${series.titleEn}`} description={series.descriptionEn} active="series">
	<article class="series-page">
		<header class="series-intro">
			<h1 class="translatable" data-en={series.titleEn} data-zh={series.titleZh}>{series.titleEn}</h1>
			{(series.descriptionEn || series.descriptionZh) && <p class="description translatable" data-en={series.descriptionEn} data-zh={series.descriptionZh}>{series.descriptionEn}</p>}
			{series.year && <p class="series-meta">{series.year}</p>}
		</header>
		<section class="series-gallery" aria-label="Series media">
			{columns.map((column) => <div class="gallery-column">
				{column.map((item) => item.type === 'image' ? (
					<button class="media-button image-button" type="button" data-lightbox-index={item.lightboxIndex} aria-label={`View series image ${item.lightboxIndex + 1}`}>
						<img src={item.url} alt={`Series image ${item.lightboxIndex + 1}`} loading={item.order < 4 ? 'eager' : 'lazy'} decoding="async" />
					</button>
				) : (
					<button class="media-button video-button" type="button" data-video-src={item.url} aria-label={`Play series video ${item.number}`}>
						{item.cover ? <img src={item.cover} alt="" loading="eager" decoding="async" /> : <span class="video-placeholder" aria-hidden="true"></span>}
						<span class="play-icon" aria-hidden="true"></span>
					</button>
				))}
			</div>)}
		</section>
		<ImageLightbox items={lightboxImages} triggerSelector=".series-gallery .image-button" ariaLabel="Series image viewer" />
		<dialog class="media-dialog video-dialog" aria-label="Series video player">
			<button class="dialog-close" type="button" aria-label="Close video player">CLOSE</button>
			<video controls muted loop playsinline></video>
		</dialog>
	</article>
</PortfolioLayout>

<script>
	const videoDialog = document.querySelector<HTMLDialogElement>('.video-dialog');
	const dialogVideo = videoDialog?.querySelector<HTMLVideoElement>('video');
	const closeVideo = () => {
		if (dialogVideo) {
			dialogVideo.pause();
			dialogVideo.removeAttribute('src');
			dialogVideo.load();
		}
		videoDialog?.close();
	};
	document.querySelectorAll<HTMLButtonElement>('.video-button').forEach((button) => {
		button.addEventListener('click', async () => {
			if (!videoDialog || !dialogVideo || !button.dataset.videoSrc) return;
			dialogVideo.src = button.dataset.videoSrc;
			videoDialog.showModal();
			await dialogVideo.play().catch(() => undefined);
		});
	});
	videoDialog?.querySelector<HTMLButtonElement>('.dialog-close')?.addEventListener('click', closeVideo);
	videoDialog?.addEventListener('click', (event) => { if (event.target === videoDialog) closeVideo(); });
	videoDialog?.addEventListener('cancel', () => {
		if (dialogVideo) {
			dialogVideo.pause();
			dialogVideo.removeAttribute('src');
			dialogVideo.load();
		}
	});
</script>

<style>
	.series-page { padding-top: clamp(60px, 6vw, 95px); }
	.series-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; min-height: 260px; padding: 0 50px 48px; }
	h1, p { margin: 0; font-weight: 400; }
	h1 { font-size: 14px; line-height: 1; letter-spacing: .04em; }
	.description { max-width: 430px; font-size: 11px; line-height: 1.8; }
	.series-meta { color: #777; font-size: 12px; line-height: 1.4; letter-spacing: .03em; }
	.series-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 50px; width: 100%; min-height: 45vh; padding: 20px 50px 50px; }
	.gallery-column { display: flex; flex-direction: column; gap: 50px; min-width: 0; }
	.media-button { display: block; position: relative; width: 100%; border: 0; margin: 0; padding: 0; overflow: hidden; background: transparent; cursor: pointer; }
	.media-button img { display: block; width: 100%; height: auto; object-fit: contain; }
	.image-button { cursor: zoom-in; }
	.video-placeholder { display: block; width: 100%; aspect-ratio: 16 / 9; background: #111; }
	.play-icon { display: grid; place-items: center; position: absolute; top: 50%; left: 50%; width: 52px; height: 52px; border: 1px solid rgba(255, 255, 255, .9); border-radius: 50%; background: rgba(0, 0, 0, .28); transform: translate(-50%, -50%); }
	.play-icon::after { content: ''; width: 0; height: 0; margin-left: 3px; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 10px solid #fff; }
	.media-dialog { position: fixed; inset: 0; width: 100vw; max-width: none; height: 100vh; max-height: none; border: 0; margin: 0; padding: 35px; background: rgba(0, 0, 0, .9); }
	.media-dialog[open] { display: grid; place-items: center; }
	.media-dialog::backdrop { background: rgba(0, 0, 0, .72); }
	.video-dialog { background: #000; }
	.video-dialog video { display: block; max-width: 100%; max-height: calc(100vh - 70px); width: auto; height: auto; }
	.dialog-close { position: fixed; top: 24px; right: 28px; z-index: 2; border: 0; padding: 8px; color: #fff; background: transparent; font-size: 11px; letter-spacing: .05em; cursor: pointer; }
	@media (max-width: 809px) {
		.series-page { padding-top: 48px; }
		.series-intro { gap: 28px; min-height: 240px; padding: 0 20px 40px; }
		.series-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 16px 20px 60px; }
		.gallery-column { gap: 24px; }
		.media-dialog { padding: 20px; }
		.video-dialog video { max-height: calc(100vh - 40px); }
		.dialog-close { top: 12px; right: 12px; }
	}
	@media (max-width: 520px) { .series-gallery { grid-template-columns: 1fr; } }
</style>
